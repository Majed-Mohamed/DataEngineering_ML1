# Environment Variables for NYC Motor Vehicle Collisions Dashboard
# Copy this file to .env and update with your actual values

# Google Drive Configuration
# ---------------------------
# Google Drive file ID for the dashboard data parquet file
# Get this from your Google Drive share link: https://drive.google.com/file/d/YOUR_FILE_ID/view
DRIVE_FILE_ID=1qwjegnIt8eX1PQQmjRRDNK_GYGtX9hSp

# NYC Open Data API (Optional)
# ---------------------------
# App token for higher rate limits on NYC Open Data API
# Get yours at: https://data.cityofnewyork.us/profile/app_tokens
NYC_APP_TOKEN=

# Application Configuration
# ---------------------------
# Port for local development (default: 8050)
PORT=8050

# Debug mode (set to False in production)
DEBUG=True
